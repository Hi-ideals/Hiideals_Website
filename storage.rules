rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Public read for all uploaded content
    // Only authenticated admin can upload/delete
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email));
    }

    // Site assets (logo, favicon, etc.)
    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Team photos
    match /team-photos/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Product screenshots
    match /product-screenshots/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Blog images
    match /blog-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Case study images
    match /case-study-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Service images
    match /service-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Testimonial images
    match /testimonial-images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Campaign files (uploaded by public via campaign forms)
    match /campaign_files/{allPaths=**} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Resumes — anyone can upload (job applicants), only admin can read
    match /resumes/{allPaths=**} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
